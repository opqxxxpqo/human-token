{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "human-token",
  "version": "0.1.0",
  "identifier": "io.humantoken.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "url": "widget.html",
        "title": "human-token",
        "width": 240,
        "height": 158,
        "minWidth": 8,
        "minHeight": 8,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "x": 1600,
        "y": 900,
        "focus": false
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "human-token · dashboard",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Visualize your keyboard/mouse activity as token consumption",
    "longDescription": "Desktop floating widget that shows your daily input activity in Claude Code aesthetics. Local-only — no data leaves your machine.",
    "publisher": "human-token",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
